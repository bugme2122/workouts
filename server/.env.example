# Workouts API — environment (names only; set real values in Railway, never commit secrets)
PORT=4000
# MongoDB Atlas SRV connection string, database "workouts"
MONGODB_URI=
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Subpath the app is served under in production (empty locally). Prod: /workouts
BASE_PATH=
# Trust X-Forwarded-For (Railway + Cloudflare in front). "true" in prod.
TRUST_PROXY=false
NODE_ENV=development
# Belt-and-suspenders CORS origin (same-origin in prod means this is rarely used)
CLIENT_ORIGIN=http://localhost:5173
# Max auth attempts per window (login/reset throttle)
AUTH_RATE_LIMIT_MAX=10
# Password-reset email delivery ("stub" logs the token in dev; real provider later)
EMAIL_PROVIDER=stub
# Optional: absolute path to built static app to serve (E4 wires this for /workouts)
CLIENT_DIST=
